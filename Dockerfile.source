# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY web/ ./
RUN NEXT_EXPORT=1 npm run build

FROM golang:1.26.3-bookworm AS backend
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /src/web/out/ ./server/webui/dist/
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} go build -trimpath -tags embedui -o /out/artex ./cmd/artex \
    && CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} go build -trimpath -o /out/egress-relay ./cmd/egress-relay \
    && CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} go build -trimpath -o /out/cve-import ./cmd/cve-import \
    && CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} go build -trimpath -o /out/template-import ./cmd/template-import

FROM debian:bookworm-slim AS scanengine
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && case "${TARGETARCH:-amd64}" in \
      amd64) checksum=234c12cc5288af071abdcd6f854245b6067345556e1235cf96b76725c1004357 ;; \
      arm64) checksum=d1ed1a5c0df49d8fcd64cab4ff5840b793d6bf133b082bb6a7f67d5fc0f9c327 ;; \
      *) echo 'Unsupported Nuclei architecture' >&2; exit 1 ;; \
    esac \
    && curl -fSL "https://github.com/projectdiscovery/nuclei/releases/download/v3.4.10/nuclei_3.4.10_linux_${TARGETARCH:-amd64}.zip" -o /tmp/nuclei.zip \
    && echo "$checksum  /tmp/nuclei.zip" | sha256sum -c - \
    && unzip /tmp/nuclei.zip nuclei LICENSE.md -d /engine

FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget git jq unzip ripgrep vim \
      iproute2 nftables util-linux \
      dnsutils iputils-ping netcat-openbsd inetutils-telnet whois nmap \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g @playwright/mcp@0.0.85 @playwright/cli@0.1.24 playwright@1.65.0 \
    && playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=backend /out/artex /out/cve-import /out/template-import /out/egress-relay ./
COPY --from=scanengine /engine/nuclei /usr/local/bin/nuclei
COPY --from=scanengine /engine/LICENSE.md /usr/share/doc/nuclei/LICENSE.md
COPY start.sh ./
COPY skills/ ./skills/
RUN chmod +x /app/artex /app/cve-import /app/template-import /app/egress-relay /app/start.sh
VOLUME ["/app/data"]
EXPOSE 8787 8788
ENTRYPOINT ["/app/start.sh"]
CMD ["-addr", ":8787", "-proxy", ":8788"]
